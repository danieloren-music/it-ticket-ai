# ───────────── Required ─────────────
# Supabase project (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Server-only key. NEVER expose it to the browser. Required once RLS is enabled.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Signs session cookies (HMAC-SHA256). Use a unique random value per environment (48 random bytes recommended).
SESSION_SECRET=
# Encrypts customer-provided identity-provider client secrets with AES-256-GCM. Generate 32 random bytes, base64-encoded.
IDP_ENCRYPTION_KEY=

# Optional shared, multi-tenant OIDC client owned by SmartQ.
# Tenant-specific OIDC client registrations can instead be configured by each organization manager.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Google Gemini (AI ticket classification)
GEMINI_API_KEY=
# Optional model override
GEMINI_MODEL=gemini-3.5-flash-lite

# Resend contact-form notifications (use a sender address on a verified domain).
RESEND_API_KEY=
RESEND_FROM_EMAIL=SmartQ <contact@example.com>
CONTACT_TO_EMAIL=

# ───────────── Vendor (platform) bootstrap admin ─────────────
# Lets you sign in to /platform/login before any platform admin exists in the DB.
PLATFORM_BOOTSTRAP_EMAIL=
PLATFORM_BOOTSTRAP_PASSWORD=

# ───────────── Optional ─────────────
# Public base URL, used for SSO callbacks and metadata. Required in production.
NEXT_PUBLIC_APP_URL=https://smartq-ai.vercel.app
# Public demo sandbox (the "Try SmartQ" experience). Set to "false" to disable.
DEMO_ENABLED=true
