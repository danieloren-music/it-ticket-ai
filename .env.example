# Replace every example value before importing this file into Vercel.
# Keep server keys private; never add real values to Git.

# Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=REPLACE_WITH_RANDOM_VALUE

# Exact production URL, without a trailing slash
NEXT_PUBLIC_APP_URL=https://YOUR_DOMAIN.com

# Contact form: verify the sender domain in Resend
RESEND_API_KEY=re_REPLACE_WITH_YOUR_KEY
RESEND_FROM_EMAIL="SmartQ <contact@YOUR_DOMAIN.com>"
CONTACT_TO_EMAIL=hello@YOUR_DOMAIN.com

# First-time SmartQ platform admin only. Remove from Vercel after creating a permanent admin.
PLATFORM_BOOTSTRAP_EMAIL=admin@YOUR_DOMAIN.com
PLATFORM_BOOTSTRAP_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_PASSWORD

# Optional: AI classification for real tenant tickets
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: shared OIDC app. Set both values or leave both commented out.
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=

# Optional: only when organizations store their own OIDC client secrets.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# IDP_ENCRYPTION_KEY=

# Required to run scheduled tenant automations through POST /api/cron/automations.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# CRON_SECRET=

# Optional: set to false to disable the public demo (enabled by default).
# DEMO_ENABLED=false
